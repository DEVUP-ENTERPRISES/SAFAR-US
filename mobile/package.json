{
  "name": "catodrive-mobile",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "sync:api": "node tools/sync-web.js",
    "check:api": "node tools/sync-web.js --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "export:android": "npm run export:android --workspaces --if-present",
    "customer": "npm run start -w catodrive-customer",
    "customer:clear": "npm run start -w catodrive-customer -- --clear",
    "partner": "npm run start -w catodrive-partner",
    "partner:clear": "npm run start -w catodrive-partner -- --clear"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
