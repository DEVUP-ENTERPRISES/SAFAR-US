NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=CATO
# Optional: enables the live Google Map on search (else a placeholder is shown)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Must match ADMIN_SLUG in the backend env. Every console route is /{slug}/...
# and the literal /admin path 404s.
NEXT_PUBLIC_ADMIN_SLUG=ctrl-0986-cato-admin
