NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=CATO
# Optional: enables the live Google Map on search (else a placeholder is shown)
# Maps — Mapbox is the primary provider; set this to render the results map.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY is the alternate, used only if no Mapbox token.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Must match ADMIN_SLUG in the backend env. Every console route is /{slug}/...
# and the literal /admin path 404s.
NEXT_PUBLIC_ADMIN_SLUG=ctrl-0986-cato-admin

# ── Identity verification (Stripe Identity) ──────────────────────────
# Publishable key (public — ships in the browser). Opens the document + selfie
# capture modal. The secret key + STRIPE_IDENTITY_WEBHOOK_SECRET live only on
# the backend. Without this the verify-identity screen falls back to dev mode.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# ── Push notifications (Firebase Cloud Messaging) ────────────────────
# All public (they ship in the browser bundle). The service-account key that
# can SEND push lives only on the backend. Also inline these into
# public/firebase-messaging-sw.js (a service worker can't read env).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
