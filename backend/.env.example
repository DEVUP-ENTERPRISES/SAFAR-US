# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
APP_NAME=TURA

# ─── MongoDB ───────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/tura

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── JWT ───────────────────────────────────────────────
# Password pepper: a server-side secret mixed into every password hash, kept
# OUT of the database so a DB-only breach cannot crack even weak passwords.
# Optional but recommended in production. Generate with: openssl rand -hex 32
# WARNING: never lose or casually change it — existing hashes are bound to it
# (a change forces users to re-verify; the login path upgrades them safely).
PASSWORD_PEPPER=

JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)

# ─── Rate limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Number of reverse proxies in front of this process. MUST match the real
# topology or req.ip is wrong and every IP-keyed decision breaks with it.
#   1 = Nginx only (Cloudflare DNS-only / grey cloud)
#   2 = Cloudflare orange cloud -> Nginx   <- the setup DEPLOY.md describes
# Too low: all users behind one Cloudflare POP share a rate-limit bucket.
# Too high: clients can forge X-Forwarded-For and dodge limits entirely.
TRUST_PROXY_HOPS=1

# ─── CORS (comma separated origins; * for dev) ─────────
CORS_ORIGINS=*

# ─── Stripe (leave blank in dev → mock gateway is used) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Identity verification (Stripe Identity) ──────────────────────────
# Runs on the same STRIPE_SECRET_KEY above; needs its own webhook secret
# (Stripe dashboard → Webhooks → an endpoint for identity.* events pointing
# at POST /api/v1/kyc/webhook). Without it, identity checks fall back to the
# manual ops review queue. Endpoints: POST /kyc/verification-session (start),
# POST /kyc/webhook (decision).
STRIPE_IDENTITY_WEBHOOK_SECRET=

# ─── AWS S3 (leave blank in dev → mock storage is used) ─
# ── AWS S3 (photos & documents) ───────────────────────────────────────
# Leave AWS_ACCESS_KEY_ID / S3_BUCKET blank to use the mock storage gateway
# (dev). Fill them in and storage switches to real S3 automatically — the
# client upload path is identical either way.
#
# Bucket setup (once):
#   1. Create a bucket, e.g. cato-media-prod
#   2. Block ALL public access, then serve reads through CloudFront (set
#      S3_PUBLIC_BASE_URL to the CloudFront domain). Do NOT make the bucket
#      itself public.
#   3. CORS on the bucket must allow the browser's presigned PUT:
#        [{"AllowedOrigins":["https://your-app.com","http://localhost:3000"],
#          "AllowedMethods":["PUT","GET"],
#          "AllowedHeaders":["*"],
#          "ExposeHeaders":["ETag"],"MaxAgeSeconds":3000}]
#   4. IAM user needs only: s3:PutObject on arn:aws:s3:::<bucket>/*
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# CloudFront domain (preferred) or leave blank to use the raw S3 URL.
S3_PUBLIC_BASE_URL=

# ─── Maps geocoding (Mapbox primary → Google backup → stub) ──────────
# Mapbox is the primary geocoder. Google, when set, is the backup a Mapbox
# failure falls through to. With neither, the offline stub resolves seed cities.
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# ─── Main admin (auto-seeded as super_admin on boot) ────
ADMIN_EMAIL=admin@cato.com
ADMIN_PASSWORD=change_me_strong_password
ADMIN_NAME=CATO Admin

# ── Admin console base path ──────────────────────────────────────────
# Every console route is served under /{ADMIN_SLUG}/... instead of the
# guessable /admin. This is obscurity, not authorisation: RBAC still gates
# every endpoint. Changing it changes the URL of the whole console, so keep
# NEXT_PUBLIC_ADMIN_SLUG in the frontend env identical to this value.
ADMIN_SLUG=ctrl-0986-cato-admin

# ── Public API URL ───────────────────────────────────────────────────
# Absolute, publicly reachable base of this API (no trailing slash), e.g.
# https://api.yourdomain.com. Used to build media URLs that resolve from a
# browser when no CDN is configured. Defaults to localhost in development.
PUBLIC_API_URL=

# ── Google OAuth (optional) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Notification channels ────────────────────────────────────────────
# Each channel is optional. A channel with no credentials logs loudly and
# reports failure — it never pretends to have delivered. Production without
# email + SMS logs an error at boot: hosts would not be told about booking
# requests, and those requests expire after 24h.
# Email — pick ONE of the two. SMTP wins if both are filled in.
#
# Option A: SMTP (any mailbox provider). Port 587 = STARTTLS, 465 = implicit
# TLS; SMTP_SECURE is inferred from the port when left blank.
#   Gmail / Workspace   smtp.gmail.com:587       — requires an App Password,
#                                                  your normal password is refused
#   Zoho                smtp.zoho.com:587
#   Amazon SES          email-smtp.<region>.amazonaws.com:587
#                                                — SES SMTP credentials, NOT your
#                                                  AWS access key
#   Mailgun             smtp.mailgun.org:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# Option B: a transactional HTTP API (Resend, Postmark, SendGrid).
EMAIL_API_URL=
EMAIL_API_KEY=

# Required either way. Must be an address the provider lets you send as.
EMAIL_FROM=CATO <no-reply@yourdomain.com>

# ── Observability ────────────────────────────────────────────────────
# Sentry DSN. Without it, errors are logged locally only — the app still runs,
# but nothing pages you when production breaks.
SENTRY_DSN=
# Release identifier shown against each error (e.g. the git SHA of the deploy).
RELEASE=

# SMS — Twilio. SMS_FROM must be a number you own on that account.
# Auth: prefer an API key (SK…) + secret — scoped to SMS and revocable without
# resetting the whole account. SMS_ACCOUNT_SID (AC…) is still required; it
# identifies the account in the request URL. SMS_AUTH_TOKEN is a legacy fallback.
SMS_ACCOUNT_SID=
SMS_API_KEY_SID=
SMS_API_KEY_SECRET=
SMS_AUTH_TOKEN=
SMS_FROM=

# Push — Firebase Cloud Messaging server key.
# Push — Firebase Cloud Messaging (HTTP v1). Base64 of the service-account
# JSON: base64 -w0 service-account.json. This is a SECRET — keep it out of git.
# (FCM_SERVER_KEY is the dead legacy API, unused.)
FCM_SERVICE_ACCOUNT_BASE64=

# Verify credentials without making a booking:
#   POST /api/v1/notifications/test   (super_admin; sends to your own account)

# ─── ADMIN ROUTE REGISTRY (generated — do not edit by hand) ───────────
# Source of truth: src/modules/admin/admin.nav.ts, served at GET /admin/nav.
# Regenerate with: npm run admin:routes
# Listed here for reference only; nothing reads these values.
# SLUG            PATH                                 API                       PERMISSION
#   ── Overview ──
# dashboard       /ctrl-0986-cato-admin                /admin/metrics            admin:read
# analytics       /ctrl-0986-cato-admin/analytics      /admin/analytics          analytics:read
#   ── People ──
# users           /ctrl-0986-cato-admin/users          /admin/users              admin:read
# kyc             /ctrl-0986-cato-admin/kyc            /admin/kyc                kyc:review
# hosts           /ctrl-0986-cato-admin/hosts          /admin/hosts              admin:read
#   ── Supply ──
# vehicles        /ctrl-0986-cato-admin/vehicles       /admin/vehicles           admin:read
# fleets          /ctrl-0986-cato-admin/fleets         /admin/fleets             fleet:manage
#   ── Operations ──
# bookings        /ctrl-0986-cato-admin/bookings       /admin/bookings           admin:read
# claims          /ctrl-0986-cato-admin/claims         /admin/claims             claim:manage
# support         /ctrl-0986-cato-admin/support        /admin/tickets            ticket:manage
# reviews         /ctrl-0986-cato-admin/reviews        /admin/reviews            review:moderate
#   ── Business ──
# corporate       /ctrl-0986-cato-admin/corporate      /admin/corporate/orgs     corporate:manage
# payouts         /ctrl-0986-cato-admin/payouts        /admin/payouts            payout:manage
#   ── Revenue ──
# commission      /ctrl-0986-cato-admin/commission     /admin/commission-rules   admin:read
# finance         /ctrl-0986-cato-admin/finance        /admin/finance            analytics:read
# economics       /ctrl-0986-cato-admin/economics      /admin/config             admin:read
# surge           /ctrl-0986-cato-admin/surge          /admin/surge-rules        admin:read
# memberships     /ctrl-0986-cato-admin/memberships    /admin/subscription-plans admin:read
#   ── Platform ──
# feature-flags   /ctrl-0986-cato-admin/settings       /admin/feature-flags      admin:read
# audit           /ctrl-0986-cato-admin/audit          /admin/audit-logs         admin:read
# ──────────────────────────────────────────────────────────────────────

# ── Branding (used in email headers and footers) ──────────────────────
BRAND_NAME=SAFAR
# The web app, so email links land on a page rather than on JSON.
WEB_URL=
# CAN-SPAM requires a real postal address on outbound mail, and its absence
# hurts deliverability even for transactional messages.
COMPANY_ADDRESS=
SUPPORT_EMAIL=

# ── Social sign-in ────────────────────────────────────────────────────
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── AI (OpenRouter) ───────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FALLBACK=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
AI_DAILY_BUDGET_CENTS=2000

# ── Vehicle history (paid, optional) ──────────────────────────────────
VINAUDIT_API_KEY=
