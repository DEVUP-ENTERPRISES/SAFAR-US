# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=TURA

# ─── MongoDB ───────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/tura

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)

# ─── Rate limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ─── CORS (comma separated origins; * for dev) ─────────
CORS_ORIGINS=*
