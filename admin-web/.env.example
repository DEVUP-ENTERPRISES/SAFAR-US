# The standalone admin app (port 3005). Points at the same backend API.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# The console is reachable ONLY under this secret path — e.g.
# /ctrl-0986-cato-admin/login. Any other path, including /login and /, returns
# 404, so nothing is discoverable without knowing the slug. Use a long random
# value and keep it out of anything public.
NEXT_PUBLIC_ADMIN_SLUG=change-me-to-a-long-random-slug
